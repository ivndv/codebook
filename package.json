{
	"name": "codebook",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "bun run i18n && next dev",
		"build": "bun run i18n && next build",
		"start": "next start",
		"i18n": "paraglide-js compile --project ./project.inlang",
		"typecheck": "bun run i18n && next typegen && tsc --noEmit",
		"lint": "biome check --write .",
		"format": "biome format --write .",
		"check": "biome check .",
		"db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.0",
		"@upstash/ratelimit": "^2.2.0",
		"@upstash/redis": "^1.41.0",
		"highlight.js": "^11.12.0",
		"html-to-image": "^1.11.13",
		"lucide-react": "^1.71.0",
		"next": "16.4.6",
		"next-themes": "^0.4.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.6",
		"@inlang/paraglide-js": "^3.2.1",
		"@tailwindcss/turbopack": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"supabase": "^3.1.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vercel": "65.14.0"
	},
	"packageManager": "bun@1.4.4",
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	]
}
