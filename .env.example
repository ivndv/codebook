# Variables de entorno de codebook
# Copia este archivo a `.env.local` (front) y a `.env` (CLI) y rellena los valores.
# `.env*` está en .gitignore: los secretos NUNCA se suben.

# ---- Supabase (front) → `.env.local` ----
# Los saca la CLI con: bunx supabase status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- codebook-api (F8) → `.env.local` ----
CODEBOOK_API_URL=http://localhost:8000
CODEBOOK_API_KEY=

# ---- Upstash Redis (rate limit) → `.env.local` y Vercel ----
# Crea una base gratis en https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Google OAuth (F6b) → `.env` (raíz, lo lee la Supabase CLI) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
