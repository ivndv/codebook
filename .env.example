# Variables de entorno de codebook
# Copia este archivo a `.env.local` (front) y a `.env` (CLI) y rellena los valores.
# `.env*` está en .gitignore: los secretos NUNCA se suben.

# ---- Supabase (front) → `.env.local` ----
# Los saca la CLI con: bunx supabase status
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---- Cloudflare Turnstile (captcha de auth) → `.env.local` ----
# En local puedes usar la llave de prueba de Cloudflare (siempre pasa).
# En producción, crea el widget en el dashboard de Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ---- codebook-api (F8) → `.env.local` ----
CODEBOOK_API_URL=http://localhost:8000
CODEBOOK_API_KEY=

# ---- Upstash Redis (rate limit) → `.env.local` y Vercel ----
# Crea una base gratis en https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Entorno usado en el prefijo de las llaves: codebook:<env>:analisis
APP_ENV=production

# ---- Google OAuth (F6b) → `.env` (raíz, lo lee la Supabase CLI) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Turnstile + Resend (CLI de Supabase) → `.env` (raíz) ----
# Turnstile: en local usa el secreto de prueba (siempre pasa).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Resend: solo se usa cuando `[auth.email.smtp]` está habilitado.
RESEND_API_KEY=
